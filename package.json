{
  "name": "net-manager",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "VITE_NETORCH_SANDBOX=1 vite --port 1422",
    "build:macos": "bash scripts/build-macos-native.sh",
    "test:sandbox": "node --experimental-strip-types --test tests/sandbox.test.ts",
    "test:i18n": "node --experimental-strip-types --test tests/i18n.test.ts && python3 -m unittest discover -s tests -p 'test_localizations.py'",
    "i18n:generate": "python3 scripts/generate-localizations.py",
    "i18n:check": "python3 scripts/generate-localizations.py --check",
    "build": "python3 scripts/generate-ui-theme.py --check && python3 scripts/generate-localizations.py --check && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
