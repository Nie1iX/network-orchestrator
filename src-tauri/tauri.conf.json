{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Network Orchestrator",
  "identifier": "com.netmanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Network Orchestrator",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "devCsp": "default-src 'self' http://localhost:1420; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyMDQ2OERBNEI5QkQ1MjgKUldRbzFadEwybWdFZ3RXOUF3T1BaaXNPUHJhWUovWE5QWWZ2Vjg2eHo3VTF4TEk5V3NrdmwxQjQK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "systemd",
          "polkitd",
          "iproute2"
        ],
        "recommends": [
          "systemd-resolved",
          "wireguard-tools",
          "openvpn"
        ],
        "files": {
          "/usr/bin/network-orchestrator-daemon": "../target/release/network-orchestrator-daemon",
          "/usr/lib/network-orchestrator/xray/v26.3.27/xray": "../target/release/xray-package/v26.3.27/xray",
          "/usr/lib/network-orchestrator/xray/v26.3.27/geoip.dat": "../target/release/xray-package/v26.3.27/geoip.dat",
          "/usr/lib/network-orchestrator/xray/v26.3.27/geosite.dat": "../target/release/xray-package/v26.3.27/geosite.dat",
          "/usr/lib/systemd/system/network-orchestrator.service": "../packaging/linux/network-orchestrator.service",
          "/usr/lib/tmpfiles.d/network-orchestrator.conf": "../packaging/linux/tmpfiles.conf",
          "/usr/share/polkit-1/actions/com.netmanager.app.policy": "../packaging/linux/com.netmanager.app.policy",
          "/usr/share/doc/network-orchestrator/xray/LICENSE": "../target/release/xray-package/v26.3.27/LICENSE",
          "/usr/share/doc/network-orchestrator/xray/README.md": "../target/release/xray-package/v26.3.27/README.md",
          "/usr/share/doc/network-orchestrator/xray/NOTICES": "../packaging/linux/xray-NOTICES"
        },
        "postInstallScript": "../packaging/linux/postinst",
        "preRemoveScript": "../packaging/linux/prerm",
        "postRemoveScript": "../packaging/linux/postrm"
      },
      "rpm": {
        "depends": [
          "systemd",
          "polkit",
          "iproute",
          "libayatana-appindicator-gtk3"
        ],
        "recommends": [
          "systemd-resolved",
          "wireguard-tools",
          "openvpn"
        ],
        "files": {
          "/usr/bin/network-orchestrator-daemon": "../target/release/network-orchestrator-daemon",
          "/usr/lib/network-orchestrator/xray/v26.3.27/xray": "../target/release/xray-package/v26.3.27/xray",
          "/usr/lib/network-orchestrator/xray/v26.3.27/geoip.dat": "../target/release/xray-package/v26.3.27/geoip.dat",
          "/usr/lib/network-orchestrator/xray/v26.3.27/geosite.dat": "../target/release/xray-package/v26.3.27/geosite.dat",
          "/usr/lib/systemd/system/network-orchestrator.service": "../packaging/linux/network-orchestrator.service",
          "/usr/lib/tmpfiles.d/network-orchestrator.conf": "../packaging/linux/tmpfiles.conf",
          "/usr/share/polkit-1/actions/com.netmanager.app.policy": "../packaging/linux/com.netmanager.app.policy",
          "/usr/share/doc/network-orchestrator/xray/LICENSE": "../target/release/xray-package/v26.3.27/LICENSE",
          "/usr/share/doc/network-orchestrator/xray/README.md": "../target/release/xray-package/v26.3.27/README.md",
          "/usr/share/doc/network-orchestrator/xray/NOTICES": "../packaging/linux/xray-NOTICES"
        },
        "postInstallScript": "../packaging/rpm/post",
        "preRemoveScript": "../packaging/rpm/preun",
        "postRemoveScript": "../packaging/rpm/postun"
      }
    }
  }
}