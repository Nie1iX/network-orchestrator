#!/bin/sh
set -e

case "$1" in
    purge)
        rm -rf -- /var/lib/network-orchestrator
        ;;
esac

case "$1" in
    remove|purge|disappear)
        if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
            systemctl daemon-reload
        fi
        ;;
esac

exit 0
