<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  PolicyKit actions for the Network Orchestrator daemon.

  The daemon checks these itself over D-Bus (CheckAuthorization) for the
  client process on the other end of its Unix socket; nothing is run via
  pkexec, so there is no exec.path annotation.

  connect-profile: connecting and disconnecting the caller's own WireGuard,
    OpenVPN and Xray profiles (including a full tunnel and its DNS), removing
    the caller's own routes and recovery cleanup. An active local session is
    allowed without a prompt, as NetworkManager allows VPN activation.
  connect-profile-admin: connecting a profile when the administrator-chosen
    VPN password mode (daemon settings.set) requires it: full tunnels and
    OpenVPN in the default mode, every connect in "always" mode.
  system-network: changing that mode, applying routes and changing link state. Prompts for an
    administrator once and caches the result (auth_admin_keep).
-->
<policyconfig>

  <vendor>Network Orchestrator</vendor>
  <vendor_url>https://github.com/Nie1iX/network-orchestrator</vendor_url>
  <icon_name>network-workgroup</icon_name>

  <action id="com.netmanager.app.connect-profile">
    <description>Connect and disconnect Network Orchestrator VPN profiles</description>
    <description xml:lang="ru">Подключать и отключать VPN-профили Network Orchestrator</description>
    <message>Network Orchestrator needs authorization to connect or disconnect a VPN profile.</message>
    <message xml:lang="ru">Network Orchestrator требует авторизацию для подключения или отключения VPN-профиля.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="com.netmanager.app.connect-profile-admin">
    <description>Connect a VPN profile that changes system-wide traffic</description>
    <description xml:lang="ru">Подключить VPN-профиль, меняющий весь трафик системы</description>
    <message>Network Orchestrator needs administrative privileges to connect this VPN profile.</message>
    <message xml:lang="ru">Network Orchestrator требует права администратора для подключения этого VPN-профиля.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="com.netmanager.app.system-network">
    <description>Change system network configuration</description>
    <description xml:lang="ru">Изменить системную конфигурацию сети</description>
    <message>Network Orchestrator needs administrative privileges to manage routes and network interfaces.</message>
    <message xml:lang="ru">Network Orchestrator требует права администратора для управления маршрутами и сетевыми интерфейсами.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

</policyconfig>
