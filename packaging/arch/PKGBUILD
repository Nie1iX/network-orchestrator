pkgname=network-orchestrator
pkgver=0.1.1
pkgrel=2
pkgdesc='Desktop network route and VPN manager'
arch=('x86_64')
url='https://github.com/Nie1iX/network-orchestrator'
license=('MIT' 'MPL-2.0' 'GPL-3.0-only')
# libappindicator-gtk3 (provided by libappindicator) is loaded at runtime by
# the tray; without it the app aborts at startup.
depends=('webkit2gtk-4.1' 'polkit' 'iproute2' 'systemd' 'libappindicator-gtk3')
optdepends=('wireguard-tools: WireGuard tunnels'
            'openvpn: OpenVPN tunnels')
makedepends=('cargo' 'nodejs' 'npm' 'pkgconf' 'openssl' 'libappindicator-gtk3' 'librsvg' 'xdotool')
options=('!lto' '!debug' '!strip')
install="${pkgname}.install"
source=("${pkgname}-${pkgver}.tar.gz"
        'Xray-linux-64.zip::https://github.com/XTLS/Xray-core/releases/download/v26.3.27/Xray-linux-64.zip')
noextract=('Xray-linux-64.zip')
# scripts/build-linux-arch.sh replaces SKIP with the local snapshot's SHA-256.
sha256sums=('SKIP'
            '23cd9af937744d97776ee35ecad4972cf4b2109d1e0fe6be9930467608f7c8ae')

build() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    npm ci
    cargo run --locked --release -p net-manager-core --example package_linux_xray -- \
        install "${srcdir}/Xray-linux-64.zip" "${srcdir}/xray-verified"
    cargo build --locked --release -p network-orchestrator-daemon
    npm run tauri build -- --no-bundle --no-sign
}

package() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    install -Dm0755 target/release/net-manager-app "${pkgdir}/usr/bin/net-manager-app"
    install -Dm0755 target/release/network-orchestrator-daemon \
        "${pkgdir}/usr/bin/network-orchestrator-daemon"
    install -Dm0644 packaging/linux/network-orchestrator.service \
        "${pkgdir}/usr/lib/systemd/system/network-orchestrator.service"
    install -Dm0644 packaging/linux/com.netmanager.app.policy \
        "${pkgdir}/usr/share/polkit-1/actions/com.netmanager.app.policy"
    install -Dm0644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    install -Dm0755 "${srcdir}/xray-verified/v26.3.27/xray" \
        "${pkgdir}/usr/lib/network-orchestrator/xray/v26.3.27/xray"
    for name in geoip.dat geosite.dat; do
        install -Dm0644 "${srcdir}/xray-verified/v26.3.27/${name}" \
            "${pkgdir}/usr/lib/network-orchestrator/xray/v26.3.27/${name}"
    done
    for name in LICENSE README.md; do
        install -Dm0644 "${srcdir}/xray-verified/v26.3.27/${name}" \
            "${pkgdir}/usr/share/doc/${pkgname}/xray/${name}"
    done
    install -Dm0644 packaging/arch/xray-NOTICES \
        "${pkgdir}/usr/share/doc/${pkgname}/xray/NOTICES"

    install -Dm0644 src-tauri/icons/32x32.png \
        "${pkgdir}/usr/share/icons/hicolor/32x32/apps/net-manager-app.png"
    install -Dm0644 src-tauri/icons/128x128.png \
        "${pkgdir}/usr/share/icons/hicolor/128x128/apps/net-manager-app.png"
    install -Dm0644 src-tauri/icons/128x128@2x.png \
        "${pkgdir}/usr/share/icons/hicolor/256x256@2/apps/net-manager-app.png"

    install -d "${pkgdir}/usr/share/applications"
    cat > "${pkgdir}/usr/share/applications/Network Orchestrator.desktop" <<'EOF'
[Desktop Entry]
Categories=Network;Utility;
Comment=Network Orchestrator — unified network interface and VPN management
Exec=net-manager-app
StartupWMClass=net-manager-app
Icon=net-manager-app
Name=Network Orchestrator
Terminal=false
Type=Application
EOF
}
